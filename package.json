{
  "name": "edem",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "mini-app",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"vite --port=3000 --host=0.0.0.0\"",
    "dev:backend": "npm run dev --workspace=backend",
    "build": "npm run build:contracts && npm run build --workspace=backend && vite build",
    "start": "node backend/dist/src/index.js",
    "build:contracts": "npm run build --workspace=packages/contracts",
    "db:push": "npm run db:push --workspace=backend",
    "db:push:force": "npm run db:push:force --workspace=backend",
    "db:migrate": "npm run db:migrate --workspace=backend",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace=backend",
    "db:generate": "npm run db:generate --workspace=backend",
    "db:seed": "npm run db:seed --workspace=backend",
    "prisma:validate": "npm run prisma:validate --workspace=backend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@hono/node-server": "^2.0.12",
    "@sentry/react": "^10.69.0",
    "@tanstack/react-query": "^5.101.4",
    "@vitejs/plugin-react": "^5.0.4",
    "@vkontakte/icons": "^3.64.1",
    "@vkontakte/vk-bridge": "^3.0.2",
    "@vkontakte/vk-bridge-mock": "^2.2.0",
    "@vkontakte/vk-bridge-react": "^2.0.1",
    "@vkontakte/vk-mini-apps-router": "^1.8.6",
    "@vkontakte/vkui": "^8.3.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "hono": "^4.12.34",
    "jose": "^6.2.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.10",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "concurrently": "^10.0.4",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
