NODE_ENV=development
# Dev-порт бэкенда читается из BACKEND_PORT (PORT используется только в production).
BACKEND_PORT=3011

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE

JWT_SECRET=replace-with-long-random-secret
VK_APP_SECRET=replace-with-vk-app-secret

# Sentry DSN (optional — leave empty to disable Sentry)
SENTRY_DSN=

# Required to expose /metrics in production. Send as Authorization: Bearer <token>.
METRICS_TOKEN=

CORS_ORIGINS=http://localhost:3000

ALLOW_DEV_AUTH=true

JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Rate limit для auth (раздельные лимитеры на каждый endpoint).
VK_AUTH_RATE_WINDOW_MS=300000
VK_AUTH_RATE_MAX=5
REFRESH_RATE_WINDOW_MS=600000
REFRESH_RATE_MAX=10

# Админ-панель: статичный токен входа. Пусто = панель выключена (403 на всё).
ADMIN_TOKEN=
# TTL админ-сессии (httpOnly cookie + JWT), по умолчанию 12 часов.
ADMIN_JWT_TTL_SECONDS=43200
# Анти-брутфорс логина админки (окно в мс, лимит за окно).
ADMIN_LOGIN_RATE_WINDOW_MS=300000
ADMIN_LOGIN_RATE_MAX=5

TRUST_PROXY=false

PUBLIC_READ_RATE_WINDOW_MS=60000
PUBLIC_READ_RATE_MAX=100
MUTATION_RATE_WINDOW_MS=60000
MUTATION_RATE_MAX=30

# User-based: «дорогие» действия по аккаунту (окно в мс, лимит за окно).
CREATE_TRIP_RATE_WINDOW_MS=86400000
CREATE_TRIP_RATE_MAX=10
CANCEL_TRIP_RATE_WINDOW_MS=86400000
CANCEL_TRIP_RATE_MAX=20
CREATE_BOOKING_RATE_WINDOW_MS=86400000
CREATE_BOOKING_RATE_MAX=20
CANCEL_BOOKING_RATE_WINDOW_MS=86400000
CANCEL_BOOKING_RATE_MAX=20

LOG_LEVEL=debug

VK_GROUP_ID=
VK_GROUP_TOKEN=
