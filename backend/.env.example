NODE_ENV=development
# Dev-порт бэкенда читается из BACKEND_PORT (PORT используется только в production).
BACKEND_PORT=3011

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE

JWT_SECRET=replace-with-long-random-secret
VK_APP_SECRET=replace-with-vk-app-secret

# Sentry DSN (optional — leave empty to disable Sentry)
SENTRY_DSN=

# Required to expose /metrics in production. Send as Authorization: Bearer <token>.
METRICS_TOKEN=

CORS_ORIGINS=http://localhost:3000

ALLOW_DEV_AUTH=true

# Dev mock-токены (mock-access-token-*/mock-refresh-token-*): принимаются
# ТОЛЬКО для пользователей из явного allowlist (comma-separated user id).
# Пусто = mock-токены отключены, даже если ALLOW_DEV_AUTH=true.
# В production ALLOW_DEV_AUTH всегда false — mock-ветка не работает вообще.
DEV_AUTH_USER_ALLOWLIST=
# TTL dev mock-токенов (сек), по умолчанию 900 (15 минут).
DEV_MOCK_TOKEN_TTL_SECONDS=900

JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Rate limit для auth (раздельные лимитеры на каждый endpoint).
VK_AUTH_RATE_WINDOW_MS=300000
VK_AUTH_RATE_MAX=5
REFRESH_RATE_WINDOW_MS=600000
REFRESH_RATE_MAX=10

# Админ-панель: статичный токен входа. Пусто = панель выключена (403 на всё).
ADMIN_TOKEN=
# TTL админ-сессии (httpOnly cookie + JWT), по умолчанию 12 часов.
ADMIN_JWT_TTL_SECONDS=43200
# Анти-брутфорс логина админки (окно в мс, лимит за окно).
ADMIN_LOGIN_RATE_WINDOW_MS=300000
ADMIN_LOGIN_RATE_MAX=5
# Лимит GET-эндпоинтов админки (IP-based; выше публичного read-лимитера —
# UI отдаёт запросами пачками).
ADMIN_READ_RATE_WINDOW_MS=60000
ADMIN_READ_RATE_MAX=300

TRUST_PROXY=false

PUBLIC_READ_RATE_WINDOW_MS=60000
PUBLIC_READ_RATE_MAX=100
MUTATION_RATE_WINDOW_MS=60000
MUTATION_RATE_MAX=30

# User-based: «дорогие» действия по аккаунту (окно в мс, лимит за окно).
CREATE_TRIP_RATE_WINDOW_MS=86400000
CREATE_TRIP_RATE_MAX=10
CANCEL_TRIP_RATE_WINDOW_MS=86400000
CANCEL_TRIP_RATE_MAX=20
CREATE_BOOKING_RATE_WINDOW_MS=86400000
CREATE_BOOKING_RATE_MAX=20
CANCEL_BOOKING_RATE_WINDOW_MS=86400000
CANCEL_BOOKING_RATE_MAX=20
# Завершение поездок водителем (PATCH /trips/:id/complete).
COMPLETE_TRIP_RATE_WINDOW_MS=86400000
COMPLETE_TRIP_RATE_MAX=20

# User-based: частые лёгкие действия по аккаунту (профиль/машина, отметки
# о прочтении уведомлений, личные списки отзывов и обращений) — в сутки.
PROFILE_UPDATE_RATE_WINDOW_MS=86400000
PROFILE_UPDATE_RATE_MAX=50
NOTIFICATION_READ_RATE_WINDOW_MS=86400000
NOTIFICATION_READ_RATE_MAX=100
REVIEWS_READ_RATE_WINDOW_MS=86400000
REVIEWS_READ_RATE_MAX=100
FEEDBACK_READ_RATE_WINDOW_MS=86400000
FEEDBACK_READ_RATE_MAX=100

LOG_LEVEL=debug

VK_GROUP_ID=
VK_GROUP_TOKEN=
