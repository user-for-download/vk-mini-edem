{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:push:force": "prisma db push --accept-data-loss",
    "db:test:push": "dotenv -e .env.test -- prisma db push --accept-data-loss",
    "db:seed": "tsx prisma/seed.ts",
    "db:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:test:migrate": "dotenv -e .env.test -- prisma migrate deploy",
    "test": "dotenv -e .env.test -- vitest run"
  },
  "dependencies": {
    "@edem/contracts": "*",
    "@hono/node-server": "^1.19.11",
    "@hono/node-ws": "^1.3.1",
    "@prisma/client": "^5.22.0",
    "@sentry/node": "^9.47.1",
    "@types/ws": "^8.18.1",
    "dotenv": "^17.2.3",
    "hono": "^4.12.34",
    "isomorphic-dompurify": "^3.19.0",
    "jose": "^6.2.8",
    "pino": "^9.14.0",
    "ws": "^8.21.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "dotenv-cli": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.2",
    "vitest": "^4.1.10"
  }
}
