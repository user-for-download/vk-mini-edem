datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

model User {
  id           String    @id @default(uuid())
  vkUserId     Int?      @unique
  name         String
  avatar       String
  rating       Float     @default(5.0)
  reviewsCount Int       @default(0)
  tripsCount   Int       @default(0)
  isVerified   Boolean   @default(false)
  notificationsEnabled Boolean @default(true)
  verificationStatus   String  @default("none") // none, pending, approved, rejected
  verifiedAt           DateTime?
  about        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  car          Car?
  driverTrips  Trip[]    @relation("DriverTrips")
  bookings     Booking[] @relation("PassengerBookings")
  reviewsGiven Review[]  @relation("AuthorReviews")
  reviewsRecv  Review[]  @relation("TargetReviews")
  notifications Notification[]
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String   // booking_created, booking_confirmed, trip_cancelled
  title     String
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt(sort: Desc)])
}

model Car {
  id        String   @id @default(uuid())
  userId    String   @unique
  model     String
  color     String
  plate     String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Trip {
  id              String    @id @default(uuid())
  driverId        String
  fromCity        String
  fromAddress     String
  toCity          String
  toAddress       String
  departureAt     DateTime
  durationMinutes Int
  distanceKm      Float
  price           Int
  seatsTotal      Int
  seatsAvailable  Int
  tags            String[]  @default([])
  comment         String?
  status          String    @default("active") // active, cancelled, completed
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  driver          User      @relation("DriverTrips", fields: [driverId], references: [id])
  bookings        Booking[]
  reviews         Review[]

  @@index([status, departureAt(sort: Asc)])
  @@index([driverId, status])
  @@index([fromCity, toCity, status])
}

model Booking {
  id          String   @id @default(uuid())
  tripId      String
  passengerId String
  seat        Int
  status      String   @default("pending") // pending, confirmed, declined, cancelled
  comment     String?
  createdAt   DateTime @default(now())

  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  passenger   User     @relation("PassengerBookings", fields: [passengerId], references: [id])

  @@index([tripId, status])
  @@index([passengerId, status])
  @@index([tripId, seat])
  @@index([tripId, passengerId])
  @@index([tripId, createdAt(sort: Desc)])
}

// Partial unique constraints создаются SQL-миграцией (Prisma не поддерживает
// `where` в @@unique):
// - active_seat_booking (tripId, seat) WHERE status IN ('pending', 'confirmed')
// - active_passenger_booking (tripId, passengerId) WHERE status IN ('pending', 'confirmed')
// См. prisma/migrations/*_booking_unique_indexes/migration.sql

model Review {
  id           String   @id @default(uuid())
  authorId     String
  targetUserId String
  targetRole   String   // passenger, driver
  rating       Int
  text         String
  tripRoute    String
  createdAt    DateTime @default(now())

  tripId       String?
  trip         Trip?    @relation(fields: [tripId], references: [id], onDelete: SetNull)

  author       User     @relation("AuthorReviews", fields: [authorId], references: [id])
  targetUser   User     @relation("TargetReviews", fields: [targetUserId], references: [id])

  @@index([targetUserId, createdAt(sort: Desc)])
  @@index([authorId, tripId])
  @@unique([authorId, tripId, targetUserId], name: "unique_review_per_trip")
}
