NODE_ENV=test
DATABASE_URL="postgresql://edem:edem_local@localhost:5433/edem_test?schema=public"

JWT_SECRET=test-jwt-secret-32-chars-long-1234567890
VK_APP_SECRET=test-vk-secret-32-chars-long-1234567890
ALLOW_DEV_AUTH=true

JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Высокие лимиты auth: интеграционные тесты не должны упираться в rate limiting.
VK_AUTH_RATE_WINDOW_MS=900000
VK_AUTH_RATE_MAX=1000
REFRESH_RATE_WINDOW_MS=900000
REFRESH_RATE_MAX=1000
CORS_ORIGINS=http://localhost:3000

# Пины trip/booking лимитов: тесты должны быть hermetic к локальному backend/.env
# (иначе поднятые для e2e лимиты ломают rate-limit тесты).
CREATE_TRIP_RATE_WINDOW_MS=86400000
CREATE_TRIP_RATE_MAX=10
CANCEL_TRIP_RATE_WINDOW_MS=86400000
CANCEL_TRIP_RATE_MAX=20
CREATE_BOOKING_RATE_WINDOW_MS=86400000
CREATE_BOOKING_RATE_MAX=20
