{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    // Сгенерированный Prisma-клиент (src/generated) импортирует свои модули
    // с явным расширением .ts: разрешаем такие импорты и переписываем их в
    // .js при сборке (tsx/vitest читают .ts напрямую).
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "noEmit": false,
    "outDir": "./dist"
  },
  "include": [
    "src/**/*",
    "prisma/**/*",
    // Keep the regression fixture in the backend typecheck without making
    // the database-backed integration suite part of the production build.
    "tests/dev-mock-auth.ts",
    "tests/integration/auth-concurrent-launch.test.ts"
  ]
}
